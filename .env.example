# Figma token sync (used by scripts/sync-tokens.js and the CI sync workflow).
# NO manual JSON export, NO file watcher — this pulls variables via the REST API.

# Org Plan Access Token (admin-generated in the Figma admin console).
# In CI this is the GitHub Actions secret FIGMA_TOKEN — never commit a real value.
FIGMA_TOKEN=figd_xxx_plan_access_token

# The Figma file (or branch) key holding the NewCo variable library.
FIGMA_FILE_KEY=zbfRuhk4GeEXSA3D1s7hmu

# Optional overrides if collection names change in Figma:
# NEWCO_PRIMITIVE_COLLECTION=Primitive: Color
# NEWCO_SEMANTIC_COLLECTION=Semantic: Color
