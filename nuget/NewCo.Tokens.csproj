<!--
  NewCo.Tokens — .NET / NuGet delivery of the NewCo (Spired) design tokens.

  A Razor Class Library (RCL): it bundles the SAME dist/tokens.css produced by
  the npm pipeline as a static web asset, plus an optional generated C# constants
  class. A Blazor / Radzen app installs the NuGet package and references:

      <link rel="stylesheet" href="_content/NewCo.Tokens/newco-tokens.css" />

  ...then styles with var(--semantic-color-...) exactly like every other tribe.

  Version is kept in lockstep with the npm package by CI (dotnet pack -p:Version=).
  Build order: `npm run build-dist` (produces dist/) then `npm run build-nuget`
  (copies CSS + generates NewCoTokens.g.cs into this folder), then `dotnet pack`.
-->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>

    <PackageId>NewCo.Tokens</PackageId>
    <Version>0.1.0</Version>
    <Authors>NewCo Design System</Authors>
    <Description>NewCo (Spired) Design System tokens for .NET / Blazor — CSS custom properties as a static web asset, 1:1 with the Figma variable library. Light + Midnight modes.</Description>
    <PackageTags>design-tokens;design-system;blazor;radzen;css;newco;spired</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/helloimjolopez-collab/newco-ds</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- newco-tokens.css is copied here by scripts/build-nuget.js and shipped as a
       static web asset, served at _content/NewCo.Tokens/newco-tokens.css -->

</Project>
