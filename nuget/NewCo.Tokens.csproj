<!--
  NewCo.Tokens : .NET / NuGet delivery of the NewCo (Spired) design tokens.
  A Razor Class Library (RCL) that bundles the same dist/tokens.css produced by
  the npm pipeline as a static web asset (served at
  _content/NewCo.Tokens/newco-tokens.css), plus a generated C# constants class.
  Blazor / Radzen apps reference the stylesheet and style with CSS variables.
  Version is kept in lockstep with the npm package by CI.
  Build order: npm run build-dist, then npm run build-nuget, then dotnet pack.
-->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>

    <PackageId>NewCo.Tokens</PackageId>
    <Version>0.1.0</Version>
    <Authors>NewCo Design System</Authors>
    <Description>NewCo (Spired) Design System tokens for .NET / Blazor — CSS custom properties as a static web asset, 1:1 with the Figma variable library. Light + Midnight modes.</Description>
    <PackageTags>design-tokens;design-system;blazor;radzen;css;newco;spired</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/helloimjolopez-collab/newco-ds</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- newco-tokens.css is copied here by scripts/build-nuget.js and shipped as a
       static web asset, served at _content/NewCo.Tokens/newco-tokens.css -->

</Project>
